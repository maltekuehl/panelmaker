# Copy to .env and fill in. Generate the secret with: openssl rand -hex 32
AUTH_SECRET="replace-me-openssl-rand-hex-32"

# Database. SHADOW_DATABASE_URL must be a separate, disposable database: prisma migrate dev drops and recreates it.
DATABASE_URL="postgresql://user:password@host:port/dbname?sslmode=require"
SHADOW_DATABASE_URL="postgresql://user:password@host:port/dbname_shadow?sslmode=require"

# Public URL of this deployment
NEXT_PUBLIC_BASE_URL="http://localhost:3000"

# AI. Optional: the server-side default provider key. Without it, users must supply their own.
GEMINI_API_KEY="your_gemini_api_key"

# Encrypts provider API keys that users and labs store. Required before anyone saves their own key.
# Generate with: openssl rand -hex 32
ENCRYPTION_KEY=""

# Optional OAuth providers. Email and password is the primary sign-in method.
AUTH_GITHUB_ID=""
AUTH_GITHUB_SECRET=""
AUTH_LINKEDIN_ID=""
AUTH_LINKEDIN_SECRET=""

# Optional: SciCrunch Elasticsearch key for richer antibody lookups. The keyless resolver is used without it.
SCICRUNCH_API_KEY=""

# Local image storage. nginx serves this directory from a shared volume in the docker stack.
UPLOADS_DIR="./data/uploads"

# Set to "true" to turn on Auth.js debug logging
AUTH_DEBUG="false"

NEXT_TELEMETRY_DISABLED=1

# Production docker stack only: credentials for the nginx HTTP basic auth gate
# in front of the whole site (docker-compose.yml). Defaults are panelmaker/panelmaker.
BASIC_AUTH_USER="panelmaker"
BASIC_AUTH_PASSWORD="panelmaker"

# Production docker stack only: Postgres container credentials (docker-compose.yml)
POSTGRES_USER="panelmaker"
POSTGRES_PASSWORD="panelmaker"
POSTGRES_DB="panelmaker"
