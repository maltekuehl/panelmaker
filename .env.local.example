# Copy to .env and fill in. Generate every secret with: openssl rand -hex 32
#
# The first section is required everywhere. Of the next two, fill in the one that matches how you
# run PanelMaker. Everything after that is optional and can stay empty.

# ============================================================================================
# Required
# ============================================================================================

# Auth.js session secret, at least 32 characters
AUTH_SECRET="replace-me-openssl-rand-hex-32"

# Public URL of this deployment. Compiled into the build, so rebuild after changing it.
# Dev server: http://localhost:3000. Docker trial: http://localhost:8080. Server: https://your.hostname
NEXT_PUBLIC_BASE_URL="http://localhost:3000"

# ============================================================================================
# Required for the Docker production stack (docker-compose.yml)
# ============================================================================================

# Postgres credentials. The compose file builds DATABASE_URL from them, so DATABASE_URL below is not
# needed there. The password ends up in a connection URL, so use a hex string. Only applied when the
# database volume is first created.
POSTGRES_PASSWORD=""
POSTGRES_USER="panelmaker"
POSTGRES_DB="panelmaker"

# ============================================================================================
# Required for local development without the Docker production stack
# ============================================================================================

DATABASE_URL="postgresql://user:password@host:port/dbname?sslmode=require"
# Optional, only used by `prisma migrate dev`. Must be a separate, disposable database: it is dropped
# and recreated.
SHADOW_DATABASE_URL=""

# ============================================================================================
# Optional: instance identity and legal pages
# ============================================================================================

# All identity is read at runtime, so one image serves any institution. Leave unset for a generic
# instance; the legal pages then show a "not configured" notice instead of made-up details.
# Display name shown in the UI, e.g. "PanelMaker Aarhus". Defaults to "PanelMaker".
INSTANCE_NAME=""
# Institution operating this instance, e.g. "Aarhus University"
INSTANCE_INSTITUTION=""
# Legal entity or person responsible for this instance (used on the legal notice page)
INSTANCE_OPERATOR=""
# Postal address of the operator. Use "\n" or literal newlines to separate address lines.
INSTANCE_ADDRESS=""
# Contact email shown on the legal pages. Must be a valid address when set.
INSTANCE_CONTACT_EMAIL=""
# Directory holding operator overrides for the legal pages: legal/notice.md, legal/privacy.md,
# legal/terms.md. See config/README.md. In the Docker image this is mounted at /app/config.
INSTANCE_CONFIG_DIR="./config"
# Let search engines index this instance. Off by default: robots.txt disallows everything, the sitemap
# is empty and pages are served as noindex. Set to "true" only for a public instance you want listed.
INSTANCE_ALLOW_INDEXING="false"

# ============================================================================================
# Optional: HTTPS proxy and basic auth (Docker production stack only)
# ============================================================================================

# SITE_ADDRESS=":80" serves plain HTTP on HTTP_PORT (localhost trial, or behind another TLS proxy).
# For automatic HTTPS set SITE_ADDRESS to your hostname, HTTP_PORT="80" and HTTPS_PORT="443".
SITE_ADDRESS=":80"
# Contact address for the certificate authority (expiry warnings)
ACME_EMAIL=""
HTTP_PORT="8080"
HTTPS_PORT="8443"
# Use 127.0.0.1 when another proxy on the same host forwards to Caddy.
PROXY_BIND="0.0.0.0"

# Site-wide HTTP basic auth gate in front of everything. Off unless both are set. Use it only with HTTPS.
BASIC_AUTH_USER=""
BASIC_AUTH_PASSWORD=""

# Node heap limit in MB for the image build. Small servers need RAM plus swap of at least this much.
BUILD_MEMORY_MB="4096"

# ============================================================================================
# Optional: AI assistant
# ============================================================================================

# Encrypts provider API keys that users and labs store. Needed before anyone saves their own key.
# At least 32 characters when set.
ENCRYPTION_KEY=""

# There is no free shared key: the chat only runs on keys someone configured.
# Precedence per provider: a user's own key (Settings), then the key of the lab the chat acts in
# (lab settings, admins and owners), then these instance keys, billed to the operator.
GOOGLE_GENERATIVE_AI_API_KEY=""
OPENAI_API_KEY=""
ANTHROPIC_API_KEY=""
# Default chat model in provider:model form. Defaults to google:gemini-3.5-flash-lite.
AI_DEFAULT_MODEL=""
# Chat requests per user per 24 hours on the instance keys above. 0 means unlimited. Default 200.
# Requests running on a user or lab key are never counted.
AI_INSTANCE_DAILY_LIMIT=""

# ============================================================================================
# Optional: sign-in, integrations, storage
# ============================================================================================

# GitHub sign-in. Email and password always works.
AUTH_GITHUB_ID=""
AUTH_GITHUB_SECRET=""

# SciCrunch Elasticsearch key for richer antibody lookups. The keyless resolver is used without it.
SCICRUNCH_API_KEY=""

# Local image storage. Files are always served through the app, which applies visibility checks.
# The Docker stack sets this itself.
UPLOADS_DIR="./data/uploads"

# Set to "true" to turn on Auth.js debug logging
AUTH_DEBUG="false"

NEXT_TELEMETRY_DISABLED=1

# ============================================================================================
# Optional: scripts
# ============================================================================================

# Used by `npm run admin:create` instead of generating a password (12 to 128 characters)
ADMIN_PASSWORD=""

# Set to 1 to skip the FPbase spectra download in `npm run setup` (offline installs)
SETUP_SKIP_FPBASE=""
