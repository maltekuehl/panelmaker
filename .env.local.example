# Copy to .env and fill in. Generate the secret with: openssl rand -hex 32
AUTH_SECRET="replace-me-openssl-rand-hex-32"

# Database. SHADOW_DATABASE_URL must be a separate, disposable database: prisma migrate dev drops and recreates it.
DATABASE_URL="postgresql://user:password@host:port/dbname?sslmode=require"
SHADOW_DATABASE_URL="postgresql://user:password@host:port/dbname_shadow?sslmode=require"

# Public URL of this deployment
NEXT_PUBLIC_BASE_URL="http://localhost:3000"

# Instance configuration. This is a self-hosted platform: one Docker image serves any research
# group or institution that deploys it, so all identity here is optional and read at runtime
# (never NEXT_PUBLIC_, those are baked into the build). Leave unset for a generic, unbranded
# instance; the legal pages show a clear "not configured" notice instead of fake data.
# Display name shown in the UI, e.g. "PanelMaker Aarhus". Defaults to "PanelMaker".
INSTANCE_NAME=""
# Institution operating this instance, e.g. "Aarhus University"
INSTANCE_INSTITUTION=""
# Legal entity or person responsible for this instance (used on the legal notice page)
INSTANCE_OPERATOR=""
# Postal address of the operator. Use "\n" or literal newlines to separate address lines.
INSTANCE_ADDRESS=""
# Contact email shown on the legal pages
INSTANCE_CONTACT_EMAIL=""
# Directory holding operator overrides for the legal pages: legal/notice.md, legal/privacy.md,
# legal/terms.md. See config/README.md. In the Docker image this is mounted at /app/config.
INSTANCE_CONFIG_DIR="./config"
# Let search engines index this instance. Off by default: robots.txt disallows everything, the sitemap
# is empty and pages are served as noindex. Set to "true" only for a public instance you want listed.
INSTANCE_ALLOW_INDEXING="false"

# AI assistant. There is no free shared key: the chat only runs on keys someone configured.
# Precedence per provider: a user's own key (Settings), then the key of the lab the chat acts in
# (lab settings, admins and owners), then these instance keys. All optional; leave empty to disable.
GOOGLE_GENERATIVE_AI_API_KEY=""
OPENAI_API_KEY=""
ANTHROPIC_API_KEY=""
# Default chat model in provider:model form. Defaults to google:gemini-3.5-flash-lite.
AI_DEFAULT_MODEL=""
# Chat requests per user per 24 hours on the instance keys above. 0 means unlimited. Default 200.
# Requests running on a user or lab key are never counted.
AI_INSTANCE_DAILY_LIMIT=""

# Encrypts provider API keys that users and labs store. Required before anyone saves their own key.
# Generate with: openssl rand -hex 32
ENCRYPTION_KEY=""

# Optional OAuth providers. Email and password is the primary sign-in method.
AUTH_GITHUB_ID=""
AUTH_GITHUB_SECRET=""

# Optional: SciCrunch Elasticsearch key for richer antibody lookups. The keyless resolver is used without it.
SCICRUNCH_API_KEY=""

# Local image storage. Files are always served through the app, which applies visibility checks.
UPLOADS_DIR="./data/uploads"

# Set to "true" to turn on Auth.js debug logging
AUTH_DEBUG="false"

NEXT_TELEMETRY_DISABLED=1

# Production docker stack only: optional nginx HTTP basic auth gate in front of the
# whole site (docker-compose.yml). Off unless both values are set. Use it only behind HTTPS.
BASIC_AUTH_USER=""
BASIC_AUTH_PASSWORD=""

# Production docker stack only: host address and port nginx is published on.
# Use 127.0.0.1 when a TLS proxy on the same host (Caddy, host nginx) forwards to it.
NGINX_BIND="0.0.0.0"
NGINX_PORT="8080"

# Production docker stack only: Postgres container credentials (docker-compose.yml).
# The password is required and ends up in a connection URL: use `openssl rand -hex 32`.
POSTGRES_USER="panelmaker"
POSTGRES_PASSWORD="change-me"
POSTGRES_DB="panelmaker"

# Optional: used by `npm run admin:create` instead of generating a password (12 to 128 characters)
ADMIN_PASSWORD=""

# Optional: set to 1 to skip the FPbase spectra download in `npm run setup` (offline installs)
SETUP_SKIP_FPBASE=""
