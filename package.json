{
  "private": true,
  "description": "Self-hosted antibody panel design for multiplexed tissue imaging",
  "repository": "https://github.com/complextissue/panelmaker",
  "homepage": "https://github.com/complextissue/panelmaker",
  "license": "Apache-2.0",
  "scripts": {
    "admin:create": "tsx scripts/create-admin.ts",
    "build": "next build",
    "build:test": "dotenv -e .env.test -- next build",
    "dev": "next dev",
    "fpbase:sync": "tsx scripts/sync-fpbase.ts",
    "ibex:fetch": "tsx scripts/fetch-ibex-source.ts",
    "ibex:import": "tsx scripts/import-ibex.ts",
    "lint": "prettier --config .prettierrc.json --check . && eslint .",
    "pathoplex:lookup": "tsx scripts/lookup-pathoplex-antibodies.ts",
    "pathoplex:proteins": "tsx scripts/resolve-pathoplex-proteins.ts",
    "pathoplex:seed": "tsx scripts/seed-pathoplex-inventory.ts",
    "postinstall": "prisma generate",
    "prepare": "husky",
    "pretest": "npm run seed:demo-user",
    "seed:all": "npm run seed:demo && npm run seed:demo-user && npm run pathoplex:seed && npm run ibex:import && npm run fpbase:sync",
    "seed:demo": "tsx prisma/seed-demo.ts",
    "seed:demo-user": "tsx scripts/create-demo-user.ts",
    "setup": "tsx scripts/setup.ts",
    "start": "next start",
    "start:test": "dotenv -e .env.test -- next start",
    "test": "dotenv -e .env.test -- playwright test",
    "test:debug": "dotenv -e .env.test -- playwright test --debug",
    "test:headed": "dotenv -e .env.test -- playwright test --headed",
    "test:report": "dotenv -e .env.test -- playwright show-report",
    "test:ui": "dotenv -e .env.test -- playwright test --ui",
    "test:unit": "tsx tests/unit/lab-access.ts && tsx tests/unit/chat.ts"
  },
