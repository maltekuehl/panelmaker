datasource db {
  provider = "postgresql"
}

generator client {
  provider = "prisma-client"
  output   = "../src/lib/generated/prisma"
}

// ─── Enums ───────────────────────────────────────────────────────────

enum UserRole {
  USER
  ADMIN
}

enum UserStatus {
  ACTIVE
  BLOCKED
}

enum Clonality {
  MONOCLONAL
  POLYCLONAL
  RECOMBINANT
  OLIGOCLONAL
}

// The preservation state (MITI `Preservation method`, OMAP `tissue_preservation`). The fixative
// chemistry is separate and lives in the ChEBI-backed `Fixative` table.
enum Preservation {
  FFPE
  FRESH_FROZEN
  FIXED_FROZEN
  FRESH
  OTHER
}

enum SampleType {
  TISSUE
  CELL_LINE
  PRIMARY_CELL_CULTURE
  ORGANOID
  OTHER
}

enum DonorSex {
  MALE
  FEMALE
  INTERSEX
  UNKNOWN
}

enum AntigenRetrieval {
  CITRATE_PH6
  TRIS_EDTA_PH9
  ENZYMATIC
  NONE
}

enum ValidationStatus {
  PENDING
  PUBLISHED
  REJECTED
}

enum Recommendation {
  RECOMMENDED
  WITH_CAVEATS
  NOT_RECOMMENDED
}

enum ValidationResult {
  SUPPORTS
  CONTRADICTS
  INCONCLUSIVE
}

enum LabRole {
  OWNER
  ADMIN
  MEMBER
  VIEWER
}

enum LabInvitationStatus {
  PENDING
  ACCEPTED
  DECLINED
  REVOKED
  EXPIRED
}

enum LabAntibodyStatus {
  IN_STOCK
  LOW
  ORDERED
  OUT_OF_STOCK
}

enum Visibility {
  PRIVATE
  LAB
  PUBLIC
}

enum ChatMessageRole {
  USER
  ASSISTANT
  SYSTEM
}

enum ApiCredentialScope {
  USER
  LAB
}

enum ApiCredentialStatus {
  UNVERIFIED
  VALID
  INVALID
}

// ─── Auth & User Models ───────────────────────────────────────────────

model User {
  id            String       @id @default(cuid())
  name          String?
  email         String       @unique
  emailVerified DateTime?
  image         String?
  password      String?
  role          UserRole     @default(USER)
  status        UserStatus   @default(ACTIVE)
  orcid         String?      @unique
  institution   String?
  institutionId String?
  accounts      Account[]
  sessions      Session[]
  experiments   Experiment[]
  panels        Panel[]

  labsCreated        Lab[]           @relation("LabCreatedBy")
  labMemberships     LabMembership[] @relation("LabMember")
  membershipsInvited LabMembership[] @relation("LabMemberInvitedBy")
  labInvitesSent     LabInvitation[] @relation("LabInviteSender")
  labInvitesAccepted LabInvitation[] @relation("LabInviteAccepter")
  labAntibodiesAdded LabAntibody[]   @relation("LabAntibodyAddedBy")

  chatConversations ChatConversation[] @relation("UserChatConversations")
  apiCredentials    ApiCredential[]    @relation("UserApiCredentials")

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

model Account {
  userId            String
  type              String
  provider          String
  providerAccountId String
  refresh_token     String?
  access_token      String?
  expires_at        Int?
  token_type        String?
  scope             String?
  id_token          String?
  session_state     String?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@id([provider, providerAccountId])
}

model Session {
  sessionToken String   @unique
  userId       String
  expires      DateTime
  user         User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

model VerificationToken {
  identifier String
  token      String
  expires    DateTime

  @@id([identifier, token])
}

// ─── Rate Limiting ────────────────────────────────────────────────────

model RateLimit {
  id              String   @id @default(cuid())
  userId          String?
  ipAddress       String?
  resourceType    String
  requestCount    Int      @default(0)
  windowStartTime DateTime @default(now())
  lastRequestTime DateTime @default(now())

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@unique([userId, resourceType])
  @@unique([ipAddress, resourceType])
  @@index([windowStartTime])
}

// ─── Chat ─────────────────────────────────────────────────────────────

model ChatMessage {
  id                String  @id @default(cuid())
  userId            String?
  modelName         String?
  inputTokens       Int     @default(0)
  totalTokens       Int     @default(0)
  reasoningTokens   Int     @default(0)
  cachedInputTokens Int     @default(0)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

// ─── Chat Conversations (server-persisted AI chat) ────────────────────

model ChatConversation {
  id      String  @id @default(cuid())
  userId  String
  title   String?
  model   String?
  pinned  Boolean @default(false)
  deleted Boolean @default(false)
  labId   String?

  user     User                      @relation("UserChatConversations", fields: [userId], references: [id], onDelete: Cascade)
  lab      Lab?                      @relation("LabChatConversations", fields: [labId], references: [id], onDelete: SetNull)
  messages ChatConversationMessage[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([userId, deleted, updatedAt])
  @@index([labId])
}

model ChatConversationMessage {
  id             String          @id @default(cuid())
  conversationId String
  role           ChatMessageRole
  content        String
  model          String?
  inputTokens    Int?
  outputTokens   Int?

  conversation ChatConversation @relation(fields: [conversationId], references: [id], onDelete: Cascade)

  createdAt DateTime @default(now())

  @@index([conversationId, createdAt])
}

model ApiCredential {
  id          String              @id @default(cuid())
  scope       ApiCredentialScope
  userId      String?
  labId       String?
  provider    String
  label       String?
  ciphertext  String
  last4       String?
  createdById String?
  status      ApiCredentialStatus @default(UNVERIFIED)
  checkedAt   DateTime?

  user User? @relation("UserApiCredentials", fields: [userId], references: [id], onDelete: Cascade)
  lab  Lab?  @relation("LabApiCredentials", fields: [labId], references: [id], onDelete: Cascade)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@unique([userId, provider])
  @@unique([labId, provider])
}

// ─── Spatial Proteomics: Ontology Models ──────────────────────────────

model CellType {
  id        String   @id
  label     String
  parentIds String[]

  markers     CellTypeMarker[]
  reportLinks ReportCellType[]
  imageLinks  ImageCellType[]

  @@index([label])
}

model Taxon {
  id    String @id
  label String

  experiments   Experiment[] @relation("ExperimentSpecies")
  antibodyHosts Antibody[]   @relation("AntibodyHost")
  panels        Panel[]

  @@index([label])
}

model Tissue {
  id        String   @id
  label     String
  partOfIds String[]

  experiments Experiment[]

  @@index([label])
}

model CellularComponent {
  id        String   @id
  label     String
  partOfIds String[]

  experimentalReports ExperimentalReport[]

  @@index([label])
}

model DiseaseCondition {
  id    String @id
  label String

  experiments Experiment[]
  panels      Panel[]

  @@index([label])
}

// ChEBI terms for fixative chemistry (CHEBI:16842 formaldehyde, CHEBI:752978 paraformaldehyde,
// CHEBI:17790 methanol, CHEBI:15347 acetone, CHEBI:64276 glutaraldehyde).
model Fixative {
  id    String @id
  label String

  experiments Experiment[]
  panels      Panel[]

  @@index([label])
}

// An external dataset that experiments were imported from, kept apart from the publication fields so
// provenance and licence attribution are never mistaken for a citation. Ids are stable slugs.
model DataSource {
  id          String  @id
  name        String
  url         String?
  license     String?
  attribution String? @db.Text

  experiments Experiment[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

// HsapDv terms for human donors, MmusDv for mouse; the ontology to search is chosen from the
// experiment species, which is the CELLxGENE convention.
model DevelopmentalStage {
  id    String @id
  label String

  experiments Experiment[]

  @@index([label])
}

model Fluorophore {
  id                    String   @id @default(cuid())
  name                  String   @unique
  excitation            Int
  emission              Int
  fpbaseId              String?  @unique
  fpbaseSlug            String?
  chebiId               String?
  aliases               String[]
  extinctionCoefficient Float?
  quantumYield          Float?
  excitationSpectrum    Json?
  emissionSpectrum      Json?

  panelMarkers        PanelMarker[]
  experimentalReports ExperimentalReport[]
  imageChannels       ImageChannel[]

  @@index([fpbaseSlug])
}

// An EFO spatial proteomics term (EFO:0700000 branch) keyed by its CURIE, or a local method EFO has no
// term for yet, keyed by a cuid and filed under its closest EFO term through `parent`.
model ImagingMethod {
  id       String  @id @default(cuid())
  label    String
  parentId String?

  parent      ImagingMethod?  @relation("ImagingMethodParent", fields: [parentId], references: [id], onDelete: Restrict)
  children    ImagingMethod[] @relation("ImagingMethodParent")
  experiments Experiment[]
  panels      Panel[]

  @@index([label])
  @@index([parentId])
}

model ReportCellType {
  reportId   String
  cellTypeId String

  report   ExperimentalReport @relation(fields: [reportId], references: [id], onDelete: Cascade)
  cellType CellType           @relation(fields: [cellTypeId], references: [id], onDelete: Cascade)

  @@id([reportId, cellTypeId])
  @@index([cellTypeId])
}

// ─── Spatial Proteomics: Protein & Marker Models ──────────────────────

model Protein {
  id            String  @id
  label         String
  geneSymbol    String?
  ensemblGeneId String?

  markers      CellTypeMarker[]
  antibodies   Antibody[]
  panelMarkers PanelMarker[]

  @@index([label])
  @@index([geneSymbol])
}

model CellTypeMarker {
  cellTypeId  String
  proteinId   String
  isCanonical Boolean @default(false)
  source      String?

  cellType CellType @relation(fields: [cellTypeId], references: [id], onDelete: Cascade)
  protein  Protein  @relation(fields: [proteinId], references: [id], onDelete: Cascade)

  @@id([cellTypeId, proteinId])
}

// ─── Spatial Proteomics: Antibody ─────────────────────────────────────

model Antibody {
  id              String     @id @default(cuid())
  rrid            String?    @unique
  name            String
  catalogNumber   String?
  cloneId         String?
  clonality       Clonality?
  hostTaxonId     String?
  targetSpecies   String[]
  targetProteinId String?
  targetName      String?
  applications    String[]
  conjugate       String?
  vendorName      String?
  vendorUrl       String?
  citationCount   Int        @default(0)

  targetProtein       Protein?             @relation(fields: [targetProteinId], references: [id], onDelete: SetNull)
  hostTaxon           Taxon?               @relation("AntibodyHost", fields: [hostTaxonId], references: [id], onDelete: SetNull)
  experimentalReports ExperimentalReport[]
  panelMarkers        PanelMarker[]
  labInventory        LabAntibody[]

  @@index([name])
  @@index([targetProteinId])
  @@index([targetName])
  @@index([hostTaxonId])
}

// ─── Spatial Proteomics: Experiment & Experimental Report ─────────────

model Experiment {
  id               String            @id @default(cuid())
  name             String?
  description      String?
  citation         String?
  pmid             String?
  doi              String?
  speciesId        String?
  tissueId         String?
  imagingMethodId  String?
  antigenRetrieval AntigenRetrieval?
  conditionId      String?
  submitterId      String?
  visibility       Visibility        @default(PRIVATE)
  owningLabId      String?

  preservation          Preservation?
  preservationText      String?
  fixativeId            String?
  fixativeConcentration String?
  antigenRetrievalText  String?
  sampleType            SampleType?
  sectionThicknessUm    Float?
  donorSex              DonorSex?
  donorAge              String?
  developmentalStageId  String?
  protocolDoi           String?
  sourceId              String?

  species       Taxon?         @relation("ExperimentSpecies", fields: [speciesId], references: [id], onDelete: SetNull)
  imagingMethod ImagingMethod? @relation(fields: [imagingMethodId], references: [id], onDelete: SetNull)

  fixative           Fixative?           @relation(fields: [fixativeId], references: [id], onDelete: SetNull)
  source             DataSource?         @relation(fields: [sourceId], references: [id], onDelete: SetNull)
  developmentalStage DevelopmentalStage? @relation(fields: [developmentalStageId], references: [id], onDelete: SetNull)

  tissue    Tissue?              @relation(fields: [tissueId], references: [id], onDelete: SetNull)
  condition DiseaseCondition?    @relation(fields: [conditionId], references: [id], onDelete: SetNull)
  submitter User?                @relation(fields: [submitterId], references: [id], onDelete: SetNull)
  owningLab Lab?                 @relation("ExperimentOwningLab", fields: [owningLabId], references: [id], onDelete: SetNull)
  reports   ExperimentalReport[]
  labShares ExperimentLabShare[]
  images    Image[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([speciesId])
  @@index([tissueId])
  @@index([conditionId])
  @@index([submitterId])
  @@index([imagingMethodId])
  @@index([visibility])
  @@index([owningLabId])
  @@index([createdAt])
  @@index([preservation])
  @@index([fixativeId])
  @@index([developmentalStageId])
  @@index([sampleType])
  @@index([sourceId])
}

model ExperimentalReport {
  id                   String           @id @default(cuid())
  experimentId         String
  antibodyId           String?
  subcellularId        String?
  fluorophoreId        String?
  metalTag             String?
  cycleNumber          Int?
  dilution             String?
  incubation           String?
  status               ValidationStatus @default(PENDING)
  recommendation       Recommendation?
  concentrationUgPerMl Float?
  notes                String?

  experiment    Experiment            @relation(fields: [experimentId], references: [id], onDelete: Cascade)
  antibody      Antibody?             @relation(fields: [antibodyId], references: [id], onDelete: Restrict)
  subcellular   CellularComponent?    @relation(fields: [subcellularId], references: [id], onDelete: SetNull)
  fluorophore   Fluorophore?          @relation(fields: [fluorophoreId], references: [id], onDelete: SetNull)
  cellTypes     ReportCellType[]
  imageChannels ImageChannel[]
  validations   ReportValidation[]
  issues        ReportStainingIssue[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([experimentId])
  @@index([antibodyId])
  @@index([subcellularId])
  @@index([fluorophoreId])
  @@index([status])
  @@index([recommendation])
  @@index([createdAt])
}

// Ways of showing that a stain is specific, after the antibody validation pillars of Uhlen et al. 2016.
// No ontology covers these, so they are local rows with stable slug ids.
model ValidationMethod {
  id          String  @id
  label       String
  description String?

  reports ReportValidation[]

  @@index([label])
}

// Problems a submitter saw with a stain, including multiplex ones such as loss across cycles.
model StainingIssue {
  id          String  @id
  label       String
  description String?

  reports ReportStainingIssue[]

  @@index([label])
}

model ReportValidation {
  reportId String
  methodId String
  result   ValidationResult

  report ExperimentalReport @relation(fields: [reportId], references: [id], onDelete: Cascade)
  method ValidationMethod   @relation(fields: [methodId], references: [id], onDelete: Restrict)

  @@id([reportId, methodId])
  @@index([methodId])
}

model ReportStainingIssue {
  reportId String
  issueId  String

  report ExperimentalReport @relation(fields: [reportId], references: [id], onDelete: Cascade)
  issue  StainingIssue      @relation(fields: [issueId], references: [id], onDelete: Restrict)

  @@id([reportId, issueId])
  @@index([issueId])
}

// One field of view from an experiment. Its channels say what each colour in the picture is: the stains
// of interest point at their reports, nuclear and structural references may be dyes with no report.
model Image {
  id           String  @id @default(cuid())
  experimentId String
  url          String
  caption      String?
  sortOrder    Int     @default(0)

  experiment Experiment      @relation(fields: [experimentId], references: [id], onDelete: Cascade)
  channels   ImageChannel[]
  cellTypes  ImageCellType[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@unique([experimentId, url])
  @@index([url])
}

enum ImageChannelRole {
  TARGET
  NUCLEAR
  STRUCTURAL
}

// A channel tied to a report takes its marker and fluorophore from that report. `label` and
// `fluorophoreId` are only for channels without one, such as a DAPI or Hoechst counterstain.
// `displayColor` is the pseudo-colour the channel has in this picture, as a hex value.
model ImageChannel {
  id            String           @id @default(cuid())
  imageId       String
  role          ImageChannelRole @default(TARGET)
  reportId      String?
  label         String?
  fluorophoreId String?
  displayColor  String?
  sortOrder     Int              @default(0)

  image       Image               @relation(fields: [imageId], references: [id], onDelete: Cascade)
  report      ExperimentalReport? @relation(fields: [reportId], references: [id], onDelete: Cascade)
  fluorophore Fluorophore?        @relation(fields: [fluorophoreId], references: [id], onDelete: SetNull)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@unique([imageId, reportId])
  @@index([reportId])
  @@index([fluorophoreId])
}

model ImageCellType {
  imageId    String
  cellTypeId String

  image    Image    @relation(fields: [imageId], references: [id], onDelete: Cascade)
  cellType CellType @relation(fields: [cellTypeId], references: [id], onDelete: Cascade)

  @@id([imageId, cellTypeId])
  @@index([cellTypeId])
}

// ─── Spatial Proteomics: Panel Builder ────────────────────────────────

model Panel {
  id              String        @id @default(cuid())
  name            String
  description     String?
  speciesId       String?
  preservation    Preservation?
  fixativeId      String?
  imagingMethodId String?
  conditionId     String?
  ownerId         String?
  visibility      Visibility    @default(PRIVATE)
  owningLabId     String?

  condition     DiseaseCondition? @relation(fields: [conditionId], references: [id], onDelete: SetNull)
  species       Taxon?            @relation(fields: [speciesId], references: [id], onDelete: SetNull)
  fixative      Fixative?         @relation(fields: [fixativeId], references: [id], onDelete: SetNull)
  imagingMethod ImagingMethod?    @relation(fields: [imagingMethodId], references: [id], onDelete: SetNull)
  owner         User?             @relation(fields: [ownerId], references: [id], onDelete: SetNull)
  owningLab     Lab?              @relation("PanelOwningLab", fields: [owningLabId], references: [id], onDelete: SetNull)
  cycles        PanelCycle[]
  labShares     PanelLabShare[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([ownerId])
  @@index([conditionId])
  @@index([speciesId])
  @@index([fixativeId])
  @@index([imagingMethodId])
  @@index([visibility])
  @@index([owningLabId])
  @@index([updatedAt])
}

model PanelCycle {
  id        String  @id @default(cuid())
  panelId   String
  name      String
  notes     String?
  sortOrder Int     @default(0)

  panel   Panel         @relation(fields: [panelId], references: [id], onDelete: Cascade)
  markers PanelMarker[]

  @@index([panelId])
}

model PanelMarker {
  id            String  @id @default(cuid())
  cycleId       String
  proteinId     String?
  antibodyId    String?
  fluorophoreId String?
  metalTag      String?
  sortOrder     Int     @default(0)

  cycle       PanelCycle   @relation(fields: [cycleId], references: [id], onDelete: Cascade)
  protein     Protein?     @relation(fields: [proteinId], references: [id], onDelete: SetNull)
  antibody    Antibody?    @relation(fields: [antibodyId], references: [id], onDelete: SetNull)
  fluorophore Fluorophore? @relation(fields: [fluorophoreId], references: [id], onDelete: SetNull)

  @@index([cycleId])
  @@index([proteinId])
  @@index([antibodyId])
  @@index([fluorophoreId])
}

// ─── Labs: Teams, Membership, Invitations, Inventory ──────────────────

model Lab {
  id              String  @id @default(cuid())
  name            String
  slug            String  @unique
  description     String?
  institution     String?
  institutionId   String?
  website         String?
  isPublicProfile Boolean @default(false)
  createdById     String?

  createdBy         User?                @relation("LabCreatedBy", fields: [createdById], references: [id], onDelete: SetNull)
  memberships       LabMembership[]
  invitations       LabInvitation[]
  inventory         LabAntibody[]
  experimentShares  ExperimentLabShare[]
  panelShares       PanelLabShare[]
  owningExperiments Experiment[]         @relation("ExperimentOwningLab")
  owningPanels      Panel[]              @relation("PanelOwningLab")
  apiCredentials    ApiCredential[]      @relation("LabApiCredentials")
  chatConversations ChatConversation[]   @relation("LabChatConversations")

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([createdById])
}

model LabMembership {
  id          String   @id @default(cuid())
  userId      String
  labId       String
  role        LabRole  @default(MEMBER)
  invitedById String?
  joinedAt    DateTime @default(now())

  user      User  @relation("LabMember", fields: [userId], references: [id], onDelete: Cascade)
  lab       Lab   @relation(fields: [labId], references: [id], onDelete: Cascade)
  invitedBy User? @relation("LabMemberInvitedBy", fields: [invitedById], references: [id], onDelete: SetNull)

  @@unique([userId, labId])
  @@index([labId])
  @@index([invitedById])
}

model LabInvitation {
  id           String              @id @default(cuid())
  labId        String
  email        String?
  role         LabRole             @default(MEMBER)
  tokenHash    String              @unique
  status       LabInvitationStatus @default(PENDING)
  maxUses      Int?                @default(1)
  useCount     Int                 @default(0)
  invitedById  String?
  acceptedById String?
  expiresAt    DateTime
  acceptedAt   DateTime?

  lab        Lab   @relation(fields: [labId], references: [id], onDelete: Cascade)
  invitedBy  User? @relation("LabInviteSender", fields: [invitedById], references: [id], onDelete: SetNull)
  acceptedBy User? @relation("LabInviteAccepter", fields: [acceptedById], references: [id], onDelete: SetNull)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([labId])
  @@index([email])
  @@index([status])
  @@index([expiresAt])
  @@index([invitedById])
  @@index([acceptedById])
}

model LabAntibody {
  id                String            @id @default(cuid())
  labId             String
  antibodyId        String
  storageLocation   String?
  freezerLocation   String?
  lotNumber         String?
  vendorCatalog     String?
  aliquotsRemaining Int?
  status            LabAntibodyStatus @default(IN_STOCK)
  notes             String?
  addedById         String?

  lab      Lab      @relation(fields: [labId], references: [id], onDelete: Cascade)
  antibody Antibody @relation(fields: [antibodyId], references: [id], onDelete: Cascade)
  addedBy  User?    @relation("LabAntibodyAddedBy", fields: [addedById], references: [id], onDelete: SetNull)

  addedAt   DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@unique([labId, antibodyId])
  @@index([antibodyId])
  @@index([status])
  @@index([addedAt])
  @@index([addedById])
}

model ExperimentLabShare {
  experimentId String
  labId        String
  createdAt    DateTime @default(now())

  experiment Experiment @relation(fields: [experimentId], references: [id], onDelete: Cascade)
  lab        Lab        @relation(fields: [labId], references: [id], onDelete: Cascade)

  @@id([experimentId, labId])
  @@index([labId])
}

model PanelLabShare {
  panelId   String
  labId     String
  createdAt DateTime @default(now())

  panel Panel @relation(fields: [panelId], references: [id], onDelete: Cascade)
  lab   Lab   @relation(fields: [labId], references: [id], onDelete: Cascade)

  @@id([panelId, labId])
  @@index([labId])
}
