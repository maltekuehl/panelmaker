datasource db {
  provider = "postgresql"
}

generator client {
  provider = "prisma-client"
  output   = "../lib/generated/prisma"
}

// ─── Enums ───────────────────────────────────────────────────────────

enum UserRole {
  USER
  ADMIN
}

enum UserStatus {
  ACTIVE
  BLOCKED
}

enum AccessStatus {
  NONE
  REQUESTED
  VERIFIED
}

enum Clonality {
  MONOCLONAL
  POLYCLONAL
  RECOMBINANT
  OLIGOCLONAL
}

enum Fixation {
  FFPE
  FRESH_FROZEN
  PFA
  ACETONE
  METHANOL
  OTHER
}

// Legacy `Fixation` conflates how the specimen was preserved with what it was fixed in. The two are
// split: `Preservation` is the preservation state (MITI `Preservation method`, OMAP
// `tissue_preservation`), the fixative chemistry moves to the ChEBI-backed `Fixative` table.
enum Preservation {
  FFPE
  FRESH_FROZEN
  FIXED_FROZEN
  FRESH
  OTHER
}

enum SampleType {
  TISSUE
  CELL_LINE
  PRIMARY_CELL_CULTURE
  ORGANOID
  OTHER
}

enum DonorSex {
  MALE
  FEMALE
  INTERSEX
  UNKNOWN
}

enum DetectionModality {
  FLUORESCENCE
  MASS
  OTHER
}

enum AntigenRetrieval {
  CITRATE_PH6
  TRIS_EDTA_PH9
  ENZYMATIC
  NONE
}

enum ValidationStatus {
  PENDING
  PUBLISHED
  REJECTED
}

enum SignalQuality {
  EXCELLENT
  GOOD
  MODERATE
  POOR
  NONE
}

enum Specificity {
  HIGH
  MODERATE
  LOW
  NON_SPECIFIC
}

enum LabRole {
  OWNER
  ADMIN
  MEMBER
  VIEWER
}

enum LabInvitationStatus {
  PENDING
  ACCEPTED
  DECLINED
  REVOKED
  EXPIRED
}

enum LabAntibodyStatus {
  IN_STOCK
  LOW
  ORDERED
  OUT_OF_STOCK
}

enum Visibility {
  PRIVATE
  LAB
  PUBLIC
}

enum ChatMessageRole {
  USER
  ASSISTANT
  SYSTEM
}

enum ApiCredentialScope {
  USER
  LAB
}

// ─── Auth & User Models ───────────────────────────────────────────────

model User {
  id                String          @id @default(cuid())
  name              String?
  email             String          @unique
  emailVerified     DateTime?
  image             String?
  password          String?
  role              UserRole        @default(USER)
  status            UserStatus      @default(ACTIVE)
  accessStatus      AccessStatus    @default(NONE)
  accessRequestedAt DateTime?
  orcid             String?         @unique
  institution       String?
  institutionId     String?
  accounts          Account[]
  sessions          Session[]
  Authenticator     Authenticator[]
  blogPosts         BlogPost[]
  experiments       Experiment[]
  panels            Panel[]

  labsCreated        Lab[]           @relation("LabCreatedBy")
  labMemberships     LabMembership[] @relation("LabMember")
  membershipsInvited LabMembership[] @relation("LabMemberInvitedBy")
  labInvitesSent     LabInvitation[] @relation("LabInviteSender")
  labInvitesAccepted LabInvitation[] @relation("LabInviteAccepter")
  labAntibodiesAdded LabAntibody[]   @relation("LabAntibodyAddedBy")

  chatConversations ChatConversation[] @relation("UserChatConversations")
  apiCredentials    ApiCredential[]    @relation("UserApiCredentials")

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

model Account {
  userId            String
  type              String
  provider          String
  providerAccountId String
  refresh_token     String?
  access_token      String?
  expires_at        Int?
  token_type        String?
  scope             String?
  id_token          String?
  session_state     String?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@id([provider, providerAccountId])
}

model Session {
  sessionToken String   @unique
  userId       String
  expires      DateTime
  user         User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

model VerificationToken {
  identifier String
  token      String
  expires    DateTime

  @@id([identifier, token])
}

model Authenticator {
  credentialID         String  @unique
  userId               String
  providerAccountId    String
  credentialPublicKey  String
  counter              Int
  credentialDeviceType String
  credentialBackedUp   Boolean
  transports           String?

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@id([userId, credentialID])
}

// ─── Rate Limiting ────────────────────────────────────────────────────

model RateLimit {
  id              String   @id @default(cuid())
  userId          String?
  ipAddress       String?
  resourceType    String
  requestCount    Int      @default(0)
  windowStartTime DateTime @default(now())
  lastRequestTime DateTime @default(now())

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@unique([userId, resourceType])
  @@unique([ipAddress, resourceType])
  @@index([windowStartTime])
}

// ─── Chat ─────────────────────────────────────────────────────────────

model ChatMessage {
  id                String  @id @default(cuid())
  userId            String?
  modelName         String?
  inputTokens       Int     @default(0)
  totalTokens       Int     @default(0)
  reasoningTokens   Int     @default(0)
  cachedInputTokens Int     @default(0)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

// ─── Chat Conversations (server-persisted AI chat) ────────────────────

model ChatConversation {
  id      String  @id @default(cuid())
  userId  String
  title   String?
  model   String?
  pinned  Boolean @default(false)
  deleted Boolean @default(false)

  user     User                      @relation("UserChatConversations", fields: [userId], references: [id], onDelete: Cascade)
  messages ChatConversationMessage[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([userId, deleted, updatedAt])
}

model ChatConversationMessage {
  id             String          @id @default(cuid())
  conversationId String
  role           ChatMessageRole
  content        String
  model          String?
  inputTokens    Int?
  outputTokens   Int?

  conversation ChatConversation @relation(fields: [conversationId], references: [id], onDelete: Cascade)

  createdAt DateTime @default(now())

  @@index([conversationId, createdAt])
}

model ApiCredential {
  id          String             @id @default(cuid())
  scope       ApiCredentialScope
  userId      String?
  labId       String?
  provider    String
  label       String?
  ciphertext  String
  last4       String?
  createdById String?

  user User? @relation("UserApiCredentials", fields: [userId], references: [id], onDelete: Cascade)
  lab  Lab?  @relation("LabApiCredentials", fields: [labId], references: [id], onDelete: Cascade)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@unique([userId, provider])
  @@unique([labId, provider])
}

// ─── Blog ─────────────────────────────────────────────────────────────

model BlogPost {
  id          String    @id @default(cuid())
  title       String
  slug        String    @unique
  excerpt     String?
  content     String
  published   Boolean   @default(false)
  publishedAt DateTime?

  metaTitle       String?
  metaDescription String?
  keywords        String[]

  author   User   @relation(fields: [authorId], references: [id], onDelete: Cascade)
  authorId String

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([published])
  @@index([publishedAt])
  @@index([authorId])
  @@index([createdAt])
}

// ─── Spatial Proteomics: Ontology Models ──────────────────────────────

model CellType {
  id        String   @id
  label     String
  parentIds String[]

  markers     CellTypeMarker[]
  reportLinks ReportCellType[]
  imageLinks  ReportImageCellType[]

  @@index([label])
}

model Taxon {
  id    String @id
  label String

  experiments   Experiment[] @relation("ExperimentSpecies")
  antibodyHosts Antibody[]   @relation("AntibodyHost")
  panels        Panel[]

  @@index([label])
}

model Tissue {
  id        String   @id
  label     String
  partOfIds String[]

  experiments Experiment[]

  @@index([label])
}

model CellularComponent {
  id        String   @id
  label     String
  partOfIds String[]

  experimentalReports ExperimentalReport[]

  @@index([label])
}

model DiseaseCondition {
  id    String @id
  label String

  experiments Experiment[]
  panels      Panel[]

  @@index([label])
}

// ChEBI terms for fixative chemistry (CHEBI:16842 formaldehyde, CHEBI:752978 paraformaldehyde,
// CHEBI:17790 methanol, CHEBI:15347 acetone, CHEBI:64276 glutaraldehyde).
model Fixative {
  id    String @id
  label String

  experiments Experiment[]

  @@index([label])
}

// HsapDv terms for human donors, MmusDv for mouse; the ontology to search is chosen from the
// experiment species, which is the CELLxGENE convention.
model DevelopmentalStage {
  id    String @id
  label String

  experiments Experiment[]

  @@index([label])
}

model Fluorophore {
  id                    String   @id @default(cuid())
  name                  String   @unique
  excitation            Int
  emission              Int
  fpbaseId              String?  @unique
  fpbaseSlug            String?
  chebiId               String?
  aliases               String[]
  extinctionCoefficient Float?
  quantumYield          Float?
  excitationSpectrum    Json?
  emissionSpectrum      Json?

  panelMarkers        PanelMarker[]
  experimentalReports ExperimentalReport[]

  @@index([fpbaseSlug])
}

// Imaging assays, seeded from the EFO `spatial proteomics` branch (EFO:0700000) plus local rows for
// methods with no ontology term yet. `efoId` is deliberately optional: PathoPlex has no EFO term and
// must still be a first-class method rather than an "other" fallback.
model ImagingMethod {
  id         String            @id
  label      String
  shortLabel String
  efoId      String?           @unique
  detection  DetectionModality
  cyclic     Boolean           @default(false)
  aliases    String[]
  sortOrder  Int               @default(0)

  experiments Experiment[]
  panels      Panel[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([detection])
  @@index([sortOrder])
}

model ReportCellType {
  reportId   String
  cellTypeId String

  report   ExperimentalReport @relation(fields: [reportId], references: [id], onDelete: Cascade)
  cellType CellType           @relation(fields: [cellTypeId], references: [id], onDelete: Cascade)

  @@id([reportId, cellTypeId])
  @@index([cellTypeId])
}

// ─── Spatial Proteomics: Protein & Marker Models ──────────────────────

model Protein {
  id            String  @id
  label         String
  geneSymbol    String?
  ensemblGeneId String?

  markers      CellTypeMarker[]
  antibodies   Antibody[]
  panelMarkers PanelMarker[]

  @@index([label])
  @@index([geneSymbol])
}

model CellTypeMarker {
  cellTypeId  String
  proteinId   String
  isCanonical Boolean @default(false)
  source      String?

  cellType CellType @relation(fields: [cellTypeId], references: [id], onDelete: Cascade)
  protein  Protein  @relation(fields: [proteinId], references: [id], onDelete: Cascade)

  @@id([cellTypeId, proteinId])
}

// ─── Spatial Proteomics: Antibody ─────────────────────────────────────

model Antibody {
  id              String     @id @default(cuid())
  rrid            String?    @unique
  name            String
  catalogNumber   String?
  cloneId         String?
  clonality       Clonality?
  hostTaxonId     String?
  targetSpecies   String[]
  targetProteinId String?
  targetName      String?
  applications    String[]
  conjugate       String?
  vendorName      String?
  vendorUrl       String?
  citationCount   Int        @default(0)

  targetProtein       Protein?             @relation(fields: [targetProteinId], references: [id], onDelete: SetNull)
  hostTaxon           Taxon?               @relation("AntibodyHost", fields: [hostTaxonId], references: [id], onDelete: SetNull)
  experimentalReports ExperimentalReport[]
  panelMarkers        PanelMarker[]
  labInventory        LabAntibody[]

  @@index([name])
  @@index([targetProteinId])
  @@index([targetName])
  @@index([hostTaxonId])
}

// ─── Spatial Proteomics: Experiment & Experimental Report ─────────────

model Experiment {
  id               String            @id @default(cuid())
  name             String?
  description      String?
  citation         String?
  pmid             String?
  doi              String?
  speciesId        String?
  tissueId         String?
  // Superseded by `preservation` + `fixativeId`. Still written on every submission and still read by
  // browse filters, evidence roll-ups and the chat tools, so it stays until those move over.
  fixation         Fixation?
  imagingMethodId  String?
  antigenRetrieval AntigenRetrieval?
  conditionId      String?
  submitterId      String?
  visibility       Visibility        @default(PRIVATE)
  owningLabId      String?

  preservation          Preservation?
  preservationText      String?
  fixativeId            String?
  fixativeConcentration String?
  antigenRetrievalText  String?
  sampleType            SampleType?
  sectionThicknessUm    Float?
  donorSex              DonorSex?
  donorAge              String?
  developmentalStageId  String?
  protocolDoi           String?

  species       Taxon?         @relation("ExperimentSpecies", fields: [speciesId], references: [id], onDelete: SetNull)
  imagingMethod ImagingMethod? @relation(fields: [imagingMethodId], references: [id], onDelete: SetNull)

  fixative           Fixative?           @relation(fields: [fixativeId], references: [id], onDelete: SetNull)
  developmentalStage DevelopmentalStage? @relation(fields: [developmentalStageId], references: [id], onDelete: SetNull)

  tissue    Tissue?              @relation(fields: [tissueId], references: [id], onDelete: SetNull)
  condition DiseaseCondition?    @relation(fields: [conditionId], references: [id], onDelete: SetNull)
  submitter User?                @relation(fields: [submitterId], references: [id], onDelete: SetNull)
  owningLab Lab?                 @relation("ExperimentOwningLab", fields: [owningLabId], references: [id], onDelete: SetNull)
  reports   ExperimentalReport[]
  labShares ExperimentLabShare[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([speciesId])
  @@index([tissueId])
  @@index([conditionId])
  @@index([submitterId])
  @@index([imagingMethodId])
  @@index([visibility])
  @@index([owningLabId])
  @@index([createdAt])
  @@index([preservation])
  @@index([fixativeId])
  @@index([developmentalStageId])
  @@index([sampleType])
}

model ExperimentalReport {
  id            String           @id @default(cuid())
  experimentId  String
  antibodyId    String?
  subcellularId String?
  fluorophoreId String?
  metalTag      String?
  cycleNumber   Int?
  dilution      String?
  incubation    String?
  status        ValidationStatus @default(PENDING)
  works         Boolean?
  signalQuality SignalQuality?
  specificity   Specificity?
  notes         String?

  experiment  Experiment         @relation(fields: [experimentId], references: [id], onDelete: Cascade)
  antibody    Antibody?          @relation(fields: [antibodyId], references: [id], onDelete: Restrict)
  subcellular CellularComponent? @relation(fields: [subcellularId], references: [id], onDelete: SetNull)
  fluorophore Fluorophore?       @relation(fields: [fluorophoreId], references: [id], onDelete: SetNull)
  cellTypes   ReportCellType[]
  images      ReportImage[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([experimentId])
  @@index([antibodyId])
  @@index([subcellularId])
  @@index([fluorophoreId])
  @@index([status])
  @@index([createdAt])
}

model ReportImage {
  id        String   @id @default(cuid())
  reportId  String
  url       String
  caption   String?
  sortOrder Int      @default(0)
  createdAt DateTime @default(now())

  report    ExperimentalReport    @relation(fields: [reportId], references: [id], onDelete: Cascade)
  cellTypes ReportImageCellType[]

  @@index([reportId])
}

model ReportImageCellType {
  imageId    String
  cellTypeId String

  image    ReportImage @relation(fields: [imageId], references: [id], onDelete: Cascade)
  cellType CellType    @relation(fields: [cellTypeId], references: [id], onDelete: Cascade)

  @@id([imageId, cellTypeId])
  @@index([cellTypeId])
}

// ─── Spatial Proteomics: Panel Builder ────────────────────────────────

model Panel {
  id              String     @id @default(cuid())
  name            String
  description     String?
  speciesId       String?
  fixation        Fixation?
  imagingMethodId String?
  conditionId     String?
  ownerId         String?
  visibility      Visibility @default(PRIVATE)
  owningLabId     String?

  condition     DiseaseCondition? @relation(fields: [conditionId], references: [id], onDelete: SetNull)
  species       Taxon?            @relation(fields: [speciesId], references: [id], onDelete: SetNull)
  imagingMethod ImagingMethod?    @relation(fields: [imagingMethodId], references: [id], onDelete: SetNull)
  owner         User?             @relation(fields: [ownerId], references: [id], onDelete: SetNull)
  owningLab     Lab?              @relation("PanelOwningLab", fields: [owningLabId], references: [id], onDelete: SetNull)
  cycles        PanelCycle[]
  labShares     PanelLabShare[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([ownerId])
  @@index([conditionId])
  @@index([speciesId])
  @@index([imagingMethodId])
  @@index([visibility])
  @@index([owningLabId])
  @@index([updatedAt])
}

model PanelCycle {
  id        String  @id @default(cuid())
  panelId   String
  name      String
  notes     String?
  sortOrder Int     @default(0)

  panel   Panel         @relation(fields: [panelId], references: [id], onDelete: Cascade)
  markers PanelMarker[]

  @@index([panelId])
}

model PanelMarker {
  id            String  @id @default(cuid())
  cycleId       String
  proteinId     String?
  antibodyId    String?
  fluorophoreId String?
  metalTag      String?
  sortOrder     Int     @default(0)

  cycle       PanelCycle   @relation(fields: [cycleId], references: [id], onDelete: Cascade)
  protein     Protein?     @relation(fields: [proteinId], references: [id], onDelete: SetNull)
  antibody    Antibody?    @relation(fields: [antibodyId], references: [id], onDelete: SetNull)
  fluorophore Fluorophore? @relation(fields: [fluorophoreId], references: [id], onDelete: SetNull)

  @@index([cycleId])
  @@index([proteinId])
  @@index([antibodyId])
  @@index([fluorophoreId])
}

// ─── Labs: Teams, Membership, Invitations, Inventory ──────────────────

model Lab {
  id              String  @id @default(cuid())
  name            String
  slug            String  @unique
  description     String?
  institution     String?
  institutionId   String?
  avatarUrl       String?
  website         String?
  isPublicProfile Boolean @default(false)
  createdById     String?

  createdBy         User?                @relation("LabCreatedBy", fields: [createdById], references: [id], onDelete: SetNull)
  memberships       LabMembership[]
  invitations       LabInvitation[]
  inventory         LabAntibody[]
  experimentShares  ExperimentLabShare[]
  panelShares       PanelLabShare[]
  owningExperiments Experiment[]         @relation("ExperimentOwningLab")
  owningPanels      Panel[]              @relation("PanelOwningLab")
  apiCredentials    ApiCredential[]      @relation("LabApiCredentials")

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([createdById])
}

model LabMembership {
  id          String   @id @default(cuid())
  userId      String
  labId       String
  role        LabRole  @default(MEMBER)
  invitedById String?
  joinedAt    DateTime @default(now())

  user      User  @relation("LabMember", fields: [userId], references: [id], onDelete: Cascade)
  lab       Lab   @relation(fields: [labId], references: [id], onDelete: Cascade)
  invitedBy User? @relation("LabMemberInvitedBy", fields: [invitedById], references: [id], onDelete: SetNull)

  @@unique([userId, labId])
  @@index([labId])
  @@index([invitedById])
}

model LabInvitation {
  id           String              @id @default(cuid())
  labId        String
  email        String?
  role         LabRole             @default(MEMBER)
  tokenHash    String              @unique
  status       LabInvitationStatus @default(PENDING)
  maxUses      Int?                @default(1)
  useCount     Int                 @default(0)
  invitedById  String?
  acceptedById String?
  expiresAt    DateTime
  acceptedAt   DateTime?

  lab        Lab   @relation(fields: [labId], references: [id], onDelete: Cascade)
  invitedBy  User? @relation("LabInviteSender", fields: [invitedById], references: [id], onDelete: SetNull)
  acceptedBy User? @relation("LabInviteAccepter", fields: [acceptedById], references: [id], onDelete: SetNull)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([labId])
  @@index([email])
  @@index([status])
  @@index([expiresAt])
  @@index([invitedById])
  @@index([acceptedById])
}

model LabAntibody {
  id                String            @id @default(cuid())
  labId             String
  antibodyId        String
  storageLocation   String?
  freezerLocation   String?
  lotNumber         String?
  vendorCatalog     String?
  aliquotsRemaining Int?
  status            LabAntibodyStatus @default(IN_STOCK)
  notes             String?
  addedById         String?
  lastValidatedAt   DateTime?

  lab      Lab      @relation(fields: [labId], references: [id], onDelete: Cascade)
  antibody Antibody @relation(fields: [antibodyId], references: [id], onDelete: Cascade)
  addedBy  User?    @relation("LabAntibodyAddedBy", fields: [addedById], references: [id], onDelete: SetNull)

  addedAt   DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@unique([labId, antibodyId])
  @@index([antibodyId])
  @@index([status])
  @@index([addedAt])
  @@index([addedById])
}

model ExperimentLabShare {
  experimentId String
  labId        String
  createdAt    DateTime @default(now())

  experiment Experiment @relation(fields: [experimentId], references: [id], onDelete: Cascade)
  lab        Lab        @relation(fields: [labId], references: [id], onDelete: Cascade)

  @@id([experimentId, labId])
  @@index([labId])
}

model PanelLabShare {
  panelId   String
  labId     String
  createdAt DateTime @default(now())

  panel Panel @relation(fields: [panelId], references: [id], onDelete: Cascade)
  lab   Lab   @relation(fields: [labId], references: [id], onDelete: Cascade)

  @@id([panelId, labId])
  @@index([labId])
}
