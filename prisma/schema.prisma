datasource db {
  provider = "postgresql"
}

generator client {
  provider = "prisma-client"
  output   = "../lib/generated/prisma"
}

// ─── Enums ───────────────────────────────────────────────────────────

enum UserRole {
  USER
  ADMIN
}

enum UserStatus {
  ACTIVE
  BLOCKED
}

enum AccessStatus {
  NONE
  REQUESTED
  VERIFIED
}

enum Clonality {
  MONOCLONAL
  POLYCLONAL
  RECOMBINANT
  OLIGOCLONAL
}

enum Fixation {
  FFPE
  FRESH_FROZEN
  PFA
  ACETONE
  METHANOL
  OTHER
}

enum MultiplexMethod {
  PATHOPLEX
  CODEX
  CYCIF
  IMC
  MIBI
  IBEX
  OTHER
}

enum AntigenRetrieval {
  CITRATE_PH6
  TRIS_EDTA_PH9
  ENZYMATIC
  NONE
}

enum ValidationStatus {
  PENDING
  PUBLISHED
  REJECTED
}

enum SignalQuality {
  EXCELLENT
  GOOD
  MODERATE
  POOR
  NONE
}

enum Specificity {
  HIGH
  MODERATE
  LOW
  NON_SPECIFIC
}

enum LabRole {
  OWNER
  ADMIN
  MEMBER
  VIEWER
}

enum LabInvitationStatus {
  PENDING
  ACCEPTED
  DECLINED
  REVOKED
  EXPIRED
}

enum LabAntibodyStatus {
  IN_STOCK
  LOW
  ORDERED
  OUT_OF_STOCK
}

enum Visibility {
  PRIVATE
  LAB
  PUBLIC
}

enum ChatMessageRole {
  USER
  ASSISTANT
  SYSTEM
}

enum ApiCredentialScope {
  USER
  LAB
}

// ─── Auth & User Models ───────────────────────────────────────────────

model User {
  id                String          @id @default(cuid())
  name              String?
  email             String          @unique
  emailVerified     DateTime?
  image             String?
  password          String?
  role              UserRole        @default(USER)
  status            UserStatus      @default(ACTIVE)
  accessStatus      AccessStatus    @default(NONE)
  accessRequestedAt DateTime?
  orcid             String?         @unique
  institution       String?
  institutionId     String?
  accounts          Account[]
  sessions          Session[]
  Authenticator     Authenticator[]
  reviews           Review[]
  approvedReviews   Review[]        @relation("ReviewApprovals")
  blogPosts         BlogPost[]
  experiments       Experiment[]
  panels            Panel[]

  labsCreated        Lab[]           @relation("LabCreatedBy")
  labMemberships     LabMembership[] @relation("LabMember")
  membershipsInvited LabMembership[] @relation("LabMemberInvitedBy")
  labInvitesSent     LabInvitation[] @relation("LabInviteSender")
  labInvitesAccepted LabInvitation[] @relation("LabInviteAccepter")
  labAntibodiesAdded LabAntibody[]   @relation("LabAntibodyAddedBy")

  chatConversations ChatConversation[] @relation("UserChatConversations")
  apiCredentials    ApiCredential[]    @relation("UserApiCredentials")

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

model Account {
  userId            String
  type              String
  provider          String
  providerAccountId String
  refresh_token     String?
  access_token      String?
  expires_at        Int?
  token_type        String?
  scope             String?
  id_token          String?
  session_state     String?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@id([provider, providerAccountId])
}

model Session {
  sessionToken String   @unique
  userId       String
  expires      DateTime
  user         User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

model VerificationToken {
  identifier String
  token      String
  expires    DateTime

  @@id([identifier, token])
}

model Authenticator {
  credentialID         String  @unique
  userId               String
  providerAccountId    String
  credentialPublicKey  String
  counter              Int
  credentialDeviceType String
  credentialBackedUp   Boolean
  transports           String?

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@id([userId, credentialID])
}

// ─── Rate Limiting ────────────────────────────────────────────────────

model RateLimit {
  id              String   @id @default(cuid())
  userId          String?
  ipAddress       String?
  resourceType    String
  requestCount    Int      @default(0)
  windowStartTime DateTime @default(now())
  lastRequestTime DateTime @default(now())

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@unique([userId, resourceType])
  @@unique([ipAddress, resourceType])
  @@index([userId, resourceType])
  @@index([ipAddress, resourceType])
  @@index([windowStartTime])
}

// ─── Chat ─────────────────────────────────────────────────────────────

model ChatMessage {
  id                String  @id @default(cuid())
  userId            String?
  modelName         String?
  inputTokens       Int     @default(0)
  totalTokens       Int     @default(0)
  reasoningTokens   Int     @default(0)
  cachedInputTokens Int     @default(0)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

// ─── Chat Conversations (server-persisted AI chat) ────────────────────

model ChatConversation {
  id      String  @id @default(cuid())
  userId  String
  title   String?
  model   String?
  pinned  Boolean @default(false)
  deleted Boolean @default(false)

  user     User                      @relation("UserChatConversations", fields: [userId], references: [id], onDelete: Cascade)
  messages ChatConversationMessage[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([userId, deleted, updatedAt])
}

model ChatConversationMessage {
  id             String          @id @default(cuid())
  conversationId String
  role           ChatMessageRole
  content        String          @db.Text
  model          String?
  inputTokens    Int?
  outputTokens   Int?

  conversation ChatConversation @relation(fields: [conversationId], references: [id], onDelete: Cascade)

  createdAt DateTime @default(now())

  @@index([conversationId, createdAt])
}

model ApiCredential {
  id          String             @id @default(cuid())
  scope       ApiCredentialScope
  userId      String?
  labId       String?
  provider    String
  label       String?
  ciphertext  String             @db.Text
  last4       String?
  createdById String?

  user User? @relation("UserApiCredentials", fields: [userId], references: [id], onDelete: Cascade)
  lab  Lab?  @relation("LabApiCredentials", fields: [labId], references: [id], onDelete: Cascade)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@unique([userId, provider])
  @@unique([labId, provider])
  @@index([userId])
  @@index([labId])
}

// ─── Blog ─────────────────────────────────────────────────────────────

model BlogPost {
  id          String    @id @default(cuid())
  title       String
  slug        String    @unique
  excerpt     String?
  content     String
  published   Boolean   @default(false)
  publishedAt DateTime?

  metaTitle       String?
  metaDescription String?
  keywords        String  @default("[]")

  author   User   @relation(fields: [authorId], references: [id], onDelete: Cascade)
  authorId String

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([slug])
  @@index([published])
  @@index([publishedAt])
  @@index([authorId])
  @@index([createdAt])
}

// ─── Reviews ──────────────────────────────────────────────────────────

model Review {
  id            String   @id @default(cuid())
  name          String
  reviewBody    String
  isHelpful     Boolean
  datePublished DateTime @default(now())

  isPending  Boolean   @default(true)
  isApproved Boolean   @default(false)
  approvedBy String?
  approvedAt DateTime?

  author               User               @relation(fields: [authorId], references: [id], onDelete: Cascade)
  authorId             String
  experimentalReport   ExperimentalReport @relation(fields: [experimentalReportId], references: [id], onDelete: Cascade)
  experimentalReportId String
  approvedByUser       User?              @relation("ReviewApprovals", fields: [approvedBy], references: [id], onDelete: SetNull)

  @@unique([authorId, experimentalReportId])
  @@index([experimentalReportId])
  @@index([isHelpful])
  @@index([datePublished])
  @@index([isPending])
  @@index([isApproved])
}

// ─── Spatial Proteomics: Ontology Models ──────────────────────────────

model CellType {
  id        String @id
  label     String
  parentIds String @default("[]")

  markers     CellTypeMarker[]
  reportLinks ReportCellType[]
  imageLinks  ReportImageCellType[]

  @@index([label])
}

model Taxon {
  id    String @id
  label String

  experiments   Experiment[] @relation("ExperimentSpecies")
  antibodyHosts Antibody[]   @relation("AntibodyHost")
  panels        Panel[]

  @@index([label])
}

model Tissue {
  id        String @id
  label     String
  partOfIds String @default("[]")

  experiments Experiment[]

  @@index([label])
}

model CellularComponent {
  id        String @id
  label     String
  partOfIds String @default("[]")

  experimentalReports ExperimentalReport[]

  @@index([label])
}

model DiseaseCondition {
  id    String @id
  label String

  experiments Experiment[]
  panels      Panel[]

  @@index([label])
}

model Fluorophore {
  id         String   @id @default(cuid())
  name       String   @unique
  excitation Int
  emission   Int
  fpbaseId   String?  @unique
  chebiId    String?
  aliases    String[]

  panelMarkers        PanelMarker[]
  experimentalReports ExperimentalReport[]

  @@index([name])
}

model ReportCellType {
  reportId   String
  cellTypeId String

  report   ExperimentalReport @relation(fields: [reportId], references: [id], onDelete: Cascade)
  cellType CellType           @relation(fields: [cellTypeId], references: [id], onDelete: Cascade)

  @@id([reportId, cellTypeId])
  @@index([cellTypeId])
}

// ─── Spatial Proteomics: Protein & Marker Models ──────────────────────

model Protein {
  id            String  @id
  label         String
  geneSymbol    String?
  ensemblGeneId String?

  markers      CellTypeMarker[]
  antibodies   Antibody[]
  panelMarkers PanelMarker[]

  @@index([label])
  @@index([geneSymbol])
}

model CellTypeMarker {
  cellTypeId  String
  proteinId   String
  isCanonical Boolean @default(false)
  source      String?

  cellType CellType @relation(fields: [cellTypeId], references: [id], onDelete: Cascade)
  protein  Protein  @relation(fields: [proteinId], references: [id], onDelete: Cascade)

  @@id([cellTypeId, proteinId])
}

// ─── Spatial Proteomics: Antibody ─────────────────────────────────────

model Antibody {
  id              String     @id @default(cuid())
  rrid            String?    @unique
  name            String
  catalogNumber   String?
  cloneId         String?
  clonality       Clonality?
  hostTaxonId     String?
  targetSpecies   String     @default("[]")
  targetProteinId String?
  targetName      String?
  applications    String     @default("[]")
  conjugate       String?
  vendorName      String?
  vendorUrl       String?
  citationCount   Int        @default(0)

  targetProtein       Protein?             @relation(fields: [targetProteinId], references: [id], onDelete: SetNull)
  hostTaxon           Taxon?               @relation("AntibodyHost", fields: [hostTaxonId], references: [id], onDelete: SetNull)
  experimentalReports ExperimentalReport[]
  panelMarkers        PanelMarker[]
  labInventory        LabAntibody[]

  @@index([name])
  @@index([targetProteinId])
  @@index([targetName])
  @@index([hostTaxonId])
}

// ─── Spatial Proteomics: Experiment & Experimental Report ─────────────

model Experiment {
  id               String            @id @default(cuid())
  name             String?
  description      String?
  citation         String?           @db.Text
  pmid             String?
  doi              String?
  speciesId        String?
  tissueId         String?
  fixation         Fixation?
  method           MultiplexMethod?
  antigenRetrieval AntigenRetrieval?
  conditionId      String?
  submitterId      String?
  visibility       Visibility        @default(PUBLIC)
  owningLabId      String?

  species   Taxon?               @relation("ExperimentSpecies", fields: [speciesId], references: [id], onDelete: SetNull)
  tissue    Tissue?              @relation(fields: [tissueId], references: [id], onDelete: SetNull)
  condition DiseaseCondition?    @relation(fields: [conditionId], references: [id], onDelete: SetNull)
  submitter User?                @relation(fields: [submitterId], references: [id], onDelete: SetNull)
  owningLab Lab?                 @relation("ExperimentOwningLab", fields: [owningLabId], references: [id], onDelete: SetNull)
  reports   ExperimentalReport[]
  labShares ExperimentLabShare[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([speciesId])
  @@index([tissueId])
  @@index([conditionId])
  @@index([submitterId])
  @@index([method])
  @@index([visibility])
  @@index([owningLabId])
}

model ExperimentalReport {
  id            String           @id @default(cuid())
  experimentId  String
  antibodyId    String?
  subcellularId String?
  fluorophoreId String?
  metalTag      String?
  cycleNumber   Int?
  dilution      String?
  incubation    String?
  status        ValidationStatus @default(PENDING)
  works         Boolean?
  signalQuality SignalQuality?
  specificity   Specificity?
  notes         String?

  experiment  Experiment         @relation(fields: [experimentId], references: [id], onDelete: Cascade)
  antibody    Antibody?          @relation(fields: [antibodyId], references: [id], onDelete: SetNull)
  subcellular CellularComponent? @relation(fields: [subcellularId], references: [id], onDelete: SetNull)
  fluorophore Fluorophore?       @relation(fields: [fluorophoreId], references: [id], onDelete: SetNull)
  cellTypes   ReportCellType[]
  images      ReportImage[]
  reviews     Review[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([experimentId])
  @@index([antibodyId])
  @@index([subcellularId])
  @@index([fluorophoreId])
  @@index([status])
}

model ReportImage {
  id        String   @id @default(cuid())
  reportId  String
  url       String
  sortOrder Int      @default(0)
  createdAt DateTime @default(now())

  report    ExperimentalReport    @relation(fields: [reportId], references: [id], onDelete: Cascade)
  cellTypes ReportImageCellType[]

  @@index([reportId])
}

model ReportImageCellType {
  imageId    String
  cellTypeId String

  image    ReportImage @relation(fields: [imageId], references: [id], onDelete: Cascade)
  cellType CellType    @relation(fields: [cellTypeId], references: [id], onDelete: Cascade)

  @@id([imageId, cellTypeId])
  @@index([cellTypeId])
}

// ─── Spatial Proteomics: Panel Builder ────────────────────────────────

model Panel {
  id          String     @id @default(cuid())
  name        String
  description String?
  speciesId   String?
  fixation    Fixation?
  conditionId String?
  ownerId     String?
  visibility  Visibility @default(PRIVATE)
  owningLabId String?

  condition DiseaseCondition? @relation(fields: [conditionId], references: [id], onDelete: SetNull)
  species   Taxon?            @relation(fields: [speciesId], references: [id], onDelete: SetNull)
  owner     User?             @relation(fields: [ownerId], references: [id], onDelete: SetNull)
  owningLab Lab?              @relation("PanelOwningLab", fields: [owningLabId], references: [id], onDelete: SetNull)
  cycles    PanelCycle[]
  labShares PanelLabShare[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([ownerId])
  @@index([conditionId])
  @@index([speciesId])
  @@index([visibility])
  @@index([owningLabId])
}

model PanelCycle {
  id        String  @id @default(cuid())
  panelId   String
  name      String
  notes     String?
  sortOrder Int     @default(0)

  panel   Panel         @relation(fields: [panelId], references: [id], onDelete: Cascade)
  markers PanelMarker[]

  @@index([panelId])
}

model PanelMarker {
  id            String  @id @default(cuid())
  cycleId       String
  proteinId     String?
  antibodyId    String?
  fluorophoreId String?
  metalTag      String?
  sortOrder     Int     @default(0)

  cycle       PanelCycle   @relation(fields: [cycleId], references: [id], onDelete: Cascade)
  protein     Protein?     @relation(fields: [proteinId], references: [id], onDelete: SetNull)
  antibody    Antibody?    @relation(fields: [antibodyId], references: [id], onDelete: SetNull)
  fluorophore Fluorophore? @relation(fields: [fluorophoreId], references: [id], onDelete: SetNull)

  @@index([cycleId])
  @@index([proteinId])
  @@index([antibodyId])
  @@index([fluorophoreId])
}

// ─── Labs: Teams, Membership, Invitations, Inventory ──────────────────

model Lab {
  id              String  @id @default(cuid())
  name            String
  slug            String  @unique
  description     String?
  institution     String?
  institutionId   String?
  avatarUrl       String?
  website         String?
  isPublicProfile Boolean @default(false)
  createdById     String?

  createdBy         User?                @relation("LabCreatedBy", fields: [createdById], references: [id], onDelete: SetNull)
  memberships       LabMembership[]
  invitations       LabInvitation[]
  inventory         LabAntibody[]
  experimentShares  ExperimentLabShare[]
  panelShares       PanelLabShare[]
  owningExperiments Experiment[]         @relation("ExperimentOwningLab")
  owningPanels      Panel[]              @relation("PanelOwningLab")
  apiCredentials    ApiCredential[]      @relation("LabApiCredentials")

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([slug])
  @@index([createdById])
}

model LabMembership {
  id          String   @id @default(cuid())
  userId      String
  labId       String
  role        LabRole  @default(MEMBER)
  invitedById String?
  joinedAt    DateTime @default(now())

  user      User  @relation("LabMember", fields: [userId], references: [id], onDelete: Cascade)
  lab       Lab   @relation(fields: [labId], references: [id], onDelete: Cascade)
  invitedBy User? @relation("LabMemberInvitedBy", fields: [invitedById], references: [id], onDelete: SetNull)

  @@unique([userId, labId])
  @@index([userId])
  @@index([labId])
}

model LabInvitation {
  id           String              @id @default(cuid())
  labId        String
  email        String?
  role         LabRole             @default(MEMBER)
  tokenHash    String              @unique
  status       LabInvitationStatus @default(PENDING)
  maxUses      Int?                @default(1)
  useCount     Int                 @default(0)
  invitedById  String?
  acceptedById String?
  expiresAt    DateTime
  acceptedAt   DateTime?

  lab        Lab   @relation(fields: [labId], references: [id], onDelete: Cascade)
  invitedBy  User? @relation("LabInviteSender", fields: [invitedById], references: [id], onDelete: SetNull)
  acceptedBy User? @relation("LabInviteAccepter", fields: [acceptedById], references: [id], onDelete: SetNull)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([labId])
  @@index([email])
  @@index([status])
  @@index([expiresAt])
}

model LabAntibody {
  id                String            @id @default(cuid())
  labId             String
  antibodyId        String
  storageLocation   String?
  freezerLocation   String?
  lotNumber         String?
  vendorCatalog     String?
  aliquotsRemaining Int?
  status            LabAntibodyStatus @default(IN_STOCK)
  notes             String?
  addedById         String?
  lastValidatedAt   DateTime?

  lab      Lab      @relation(fields: [labId], references: [id], onDelete: Cascade)
  antibody Antibody @relation(fields: [antibodyId], references: [id], onDelete: Cascade)
  addedBy  User?    @relation("LabAntibodyAddedBy", fields: [addedById], references: [id], onDelete: SetNull)

  addedAt   DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@unique([labId, antibodyId])
  @@index([labId])
  @@index([antibodyId])
  @@index([status])
}

model ExperimentLabShare {
  experimentId String
  labId        String
  createdAt    DateTime @default(now())

  experiment Experiment @relation(fields: [experimentId], references: [id], onDelete: Cascade)
  lab        Lab        @relation(fields: [labId], references: [id], onDelete: Cascade)

  @@id([experimentId, labId])
  @@index([labId])
}

model PanelLabShare {
  panelId   String
  labId     String
  createdAt DateTime @default(now())

  panel Panel @relation(fields: [panelId], references: [id], onDelete: Cascade)
  lab   Lab   @relation(fields: [labId], references: [id], onDelete: Cascade)

  @@id([panelId, labId])
  @@index([labId])
}
